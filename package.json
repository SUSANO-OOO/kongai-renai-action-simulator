{
  "name": "kongai-renai-action-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22.12.0 <23"},
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test scripts/*.test.mjs",
    "check:assets": "node scripts/check-readiness.mjs assets",
    "check:release": "node scripts/check-readiness.mjs release",
    "check:budget": "node scripts/check-budget.mjs",
    "check:handoff": "node scripts/check-handoff.mjs"
  },
  "dependencies": {"three": "^0.180.0"},
  "devDependencies": {"@types/three": "^0.180.0", "typescript": "^5.9.0", "vite": "^7.1.0"}
}
